# Copy to .env and fill in. Values here win over config.json, and .env is
# gitignored, so nothing secret has to live in the tracked config file.

# Telegram, from my.telegram.org for the bridge account
KIRO_BRIDGE_API_ID=
KIRO_BRIDGE_API_HASH=
KIRO_BRIDGE_PHONE=

# Your own Telegram user id, the only account the bridge answers
KIRO_BRIDGE_OWNER_ID=

# Only needed if kiro-cli is not already logged in on this machine
KIRO_API_KEY=

# For .deepseek mode, from platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Password for the web ui, required if web_host is not 127.0.0.1
KIRO_BRIDGE_WEB_TOKEN=
